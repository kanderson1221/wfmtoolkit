{
  "name": "wfmtoolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .js,.mjs,.vue",
    "lint:fix": "eslint . --ext .js,.mjs,.vue --fix",
    "preview": "vite preview",
    "check:standards": "node scripts/check-frontend-standards.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run check:standards && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tailwindcss/vite": "^4.2.1",
    "dexie": "^4.4.2",
    "echarts": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "primevue": "^4.5.4",
    "sass": "^1.98.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
